{
  "name": "agora-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:sqlserver": "PLAYWRIGHT_E2E_DB=sqlserver playwright test",
    "test:postgres": "PLAYWRIGHT_E2E_DB=postgres playwright test",
    "test:all": "npm run test:sqlserver && npm run test:postgres",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "adm-zip": "^0.5.16"
  }
}
