{
  "Agora": {
    "PublicBaseUrl": "",
    "StorageRoot": "storage",
    "MaxFilesPerShare": 20,
    "MaxFileSizeBytes": 5368709120,
    "MaxTotalUploadBytes": 10737418240,
    "DownloadEventRetentionDays": 90,
    "ZombieUploadRetentionHours": 24,
    "Previews": {
      "MaxSourceBytes": 67108864,
      "MaxSourcePixels": 50000000,
      "TimeoutSeconds": 30
    },
    "Auth": {
      "SessionLifetimeDays": 14,
      "SessionRevalidationMinutes": 5,
      "SecureCookies": "Auto"
    },
    "GeoLookup": {
      "Enabled": true
    },
    "RateLimits": {
      "AnonymousPerMinute": 1200
    },
    "PublicUploads": {
      "MaxOpenDraftsPerToken": 20,
      "MaxOpenDraftsPerIp": 10,
      "DraftRetentionHours": 6,
      "MaxSharesPerCodePerDay": 50,
      "MaxBytesPerCodePerDay": 21474836480,
      "DefaultExpiryDays": 30
    },
    "Scratch": {
      "MaxBytes": 0,
      "MinFreeBytes": 1073741824
    },
    "SecurityHeaders": {
      "Enabled": true
    },
    "Logging": {
      "File": {
        "Enabled": true,
        "Path": "logs",
        "RetainedDays": 30
      }
    }
  },
  "Email": {
    "Provider": "resend",
    "Resend": {
      "ApiToken": "",
      "ApiUrl": "https://api.resend.com",
      "FromDisplayName": "",
      "FromAddress": "no-reply@example.com"
    },
    "FileSystem": {
      "OutputDirectory": "emails"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*"
}
