@model Agora.Web.Pages.Auth.ConfirmActionPageModel

<div class="max-w-sm mx-auto mt-16">
  <div class="text-center mb-8">
    <h1 class="font-display text-3xl tracking-tight">@Model.Heading</h1>
    <p class="text-ink-muted text-sm mt-1">@Model.Description</p>
  </div>

  @if (!Model.CanSubmit)
  {
    <div class="rounded-xl border border-border bg-cream-dark/40 p-4 text-sm text-ink-muted">
      This confirmation link is invalid. Request a new one from the page that sent it.
    </div>
  }
  else
  {
    <div class="rounded-xl border border-border bg-cream-dark/40 p-4 mb-5">
      <p class="text-xs font-medium text-ink-muted uppercase tracking-wider mb-1">Account</p>
      <p class="text-sm text-ink-light break-all">@Model.Email</p>
    </div>

    <form method="post" action="@Model.FormAction" asp-antiforgery="true" class="space-y-3">
      <input type="hidden" name="email" value="@Model.Email" />
      <input type="hidden" name="token" value="@Model.Token" />
      <button type="submit" class="w-full px-4 py-2 bg-ink text-white text-sm font-medium rounded-lg hover:bg-ink/90 transition-colors">@Model.ButtonLabel</button>
    </form>
  }

  <p class="text-sm text-ink-muted mt-6 text-center"><a href="/login" class="text-terra font-medium hover:underline">Back to sign in</a></p>
</div>
